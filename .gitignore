# Business data, derived data, scores, and reports stay local by default.
# Raw exports sometimes arrive at the project root before they are registered in
# a run manifest.  They must remain local and must never be added to Git.
/V[0-9]_*.csv
/V[0-9]_*.csv.csv
/V[0-9]_*.json
/*_Raw.csv
/*_Raw.csv.csv
/*_Raw.json
data/raw/*
!data/raw/README.md
data/processed/*
data/output/*
reports/*
runs/*
!data/processed/.gitkeep
!data/output/.gitkeep
!reports/.gitkeep

